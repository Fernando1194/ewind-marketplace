# Copy to .env and fill in with your Supabase project's values
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only used by the serverless functions in /api (set them in Vercel):
# assistant (site assistant) and extract-contract (AI contract extraction)
ANTHROPIC_API_KEY=

# Optional, site assistant only. The values below are the defaults used when unset.
# ASSISTANT_MODEL=claude-haiku-4-5
# ASSISTANT_IP_LIMIT=20        # answers per visitor per day
# ASSISTANT_GLOBAL_LIMIT=300   # answers per day, all visitors
# ASSISTANT_SALT=              # set a random value: it salts the hash that identifies a visitor
